{
  "name": "@yafh/image-map",
  "type": "module",
  "version": "1.1.2",
  "description": "Image tile generator (SDK + CLI)",
  "author": "YanAndFish",
  "license": "MIT",
  "homepage": "https://github.com/YanAndFish/image-map#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanAndFish/image-map.git",
    "directory": "packages/image-map"
  },
  "bugs": {
    "url": "https://github.com/YanAndFish/image-map/issues"
  },
  "keywords": [
    "image-tile",
    "tile-generator",
    "image-processing",
    "image-slicing",
    "tileset"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "image-map": "./bin/image-map.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "nanoid": "^5.1.6",
    "tinypool": "^2.1.0"
  },
  "optionalDependencies": {
    "@yafh/image-map-darwin-arm64": "workspace:*",
    "@yafh/image-map-linux-arm64": "workspace:*",
    "@yafh/image-map-linux-x64": "workspace:*",
    "@yafh/image-map-win32-arm64": "workspace:*",
    "@yafh/image-map-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "0.19.0-beta.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
