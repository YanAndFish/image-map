{
  "name": "@yafh/image-map",
  "type": "module",
  "version": "1.0.0",
  "description": "图片瓦片生成器 (SDK + CLI)",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "image-map": "./bin/image-map"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "nanoid": "^5.1.6",
    "tinypool": "^2.1.0"
  },
  "optionalDependencies": {
    "@yafh/image-map-darwin-arm64": "workspace:*",
    "@yafh/image-map-linux-arm64": "workspace:*",
    "@yafh/image-map-linux-x64": "workspace:*",
    "@yafh/image-map-win32-arm64": "workspace:*",
    "@yafh/image-map-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "0.19.0-beta.2"
  }
